# Copier en .env.local pour le développement (jamais de vrai secret dans ce fichier).

# Adresse publique de l'Espace pro (liens absolus, manifeste). En production : https://pro.ksp.bj
NEXT_PUBLIC_SITE_URL=http://localhost:3050

# Gateway appelée par le navigateur. En local, la gateway de ksp_back écoute sur le port 3005.
# En production : https://api.ksp.bj
NEXT_PUBLIC_API_URL=http://localhost:3005

# Origine du stockage des fichiers (adresses présignées du service file), autorisée par la CSP pour
# l'envoi des photos de terrain. Vide : envoi refusé. À fournir par environnement (à valider).
NEXT_PUBLIC_FILE_STORAGE_ORIGIN=

# Portail du groupe : les clients y ont leur espace (« Mon espace KSP »).
NEXT_PUBLIC_PORTAIL_URL=http://localhost:3010
